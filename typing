
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f8f7ff" />
  <title>星際英打研究所｜Star Typing</title>

  <style>
    :root {
      --ink: #41466f;
      --muted: #7b82a5;
      --blue: #b9d9e9;
      --blue-deep: #819fd7;
      --yellow: #f6e5a0;
      --pink: #f7cbd5;
      --lavender: #c9c5f1;
      --paper: #fffdf9;
      --line: rgba(88, 101, 150, .13);
      --shadow: 0 18px 48px rgba(111, 120, 173, .13);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      color: var(--ink);
      font-family: ui-rounded, "Arial Rounded MT Bold",
        "Noto Sans TC", "Microsoft JhengHei", system-ui, sans-serif;
      background:
        radial-gradient(circle at 12% 14%,
          rgba(192, 222, 237, .34) 0 1px, transparent 2px),
        radial-gradient(circle at 80% 31%,
          rgba(246, 216, 163, .35) 0 2px, transparent 3px),
        #f8f7ff;
      background-size: 42px 42px, 67px 67px, auto;
      overflow-x: hidden;
    }

    a {
      color: inherit;
    }

    /* 頂部導覽列 */
    .topbar {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto;
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      position: relative;
      z-index: 5;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      font-size: 15px;
      font-weight: 900;
      letter-spacing: .04em;
    }

    .brand-mark {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: #dceefa;
      box-shadow: inset 0 -3px 0 rgba(103, 144, 191, .12);
      font-size: 21px;
      transform: rotate(-7deg);
    }

    .top-note {
      font-size: 12px;
      color: var(--muted);
      letter-spacing: .08em;
    }

    /* 主視覺封面 */
    .hero {
      width: min(1120px, calc(100% - 40px));
      min-height: 610px;
      margin: 4px auto 56px;
      padding: clamp(28px, 5vw, 62px);
      position: relative;
      isolation: isolate;
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 38px;
      background: rgba(255, 254, 251, .84);
      box-shadow: var(--shadow);
      display: grid;
      grid-template-columns: minmax(0, .92fr) minmax(340px, 1.08fr);
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }

    .hero::before {
      content: "";
      position: absolute;
      inset: 12px;
      border: 1px dashed rgba(131, 151, 194, .21);
      border-radius: 28px;
      pointer-events: none;
      z-index: -1;
    }

    .hero-copy {
      position: relative;
      z-index: 2;
      padding: 12px 0;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #8288ad;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .18em;
      margin-bottom: 20px;
    }

    .eyebrow::before {
      content: "✦";
      color: #e8b8a3;
      font-size: 17px;
    }

    h1 {
      margin: 0;
      line-height: 1.16;
      font-size: clamp(40px, 5.2vw, 68px);
      letter-spacing: -.045em;
      font-weight: 950;
    }

    h1 .highlight {
      display: block;
      color: #7e9ed1;
      margin-top: 8px;
    }

    .subtitle {
      margin: 22px 0 0;
      color: #777e9e;
      line-height: 1.9;
      font-size: 15px;
      max-width: 410px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 14px;
      margin-top: 30px;
    }

    /* 遊戲開始按鈕 */
    .start-button {
      border: 0;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 11px;
      padding: 16px 25px;
      min-height: 56px;
      border-radius: 18px;
      background: #7f9fd5;
      color: white;
      font-weight: 900;
      letter-spacing: .04em;
      font-size: 15px;
      box-shadow:
        0 6px 0 #6888bf,
        0 12px 22px rgba(100, 130, 190, .17);
      transition: transform .18s ease,
        box-shadow .18s ease,
        background .18s ease;
    }

    .start-button:hover {
      transform: translateY(-3px);
      box-shadow:
        0 9px 0 #6888bf,
        0 16px 25px rgba(100,130,190,.21);
      background: #7395cd;
    }

    .start-button:active {
      transform: translateY(3px);
      box-shadow: 0 3px 0 #6888bf;
    }

    .start-button:focus-visible,
    .level-link:focus-visible,
    .text-link:focus-visible {
      outline: 3px solid #e7afbd;
      outline-offset: 4px;
    }

    .button-arrow {
      font-size: 21px;
      line-height: 1;
    }

    .tiny-note {
      font-size: 12px;
      color: #9b9fba;
      line-height: 1.6;
    }

    /* 太空插畫區 */
    .art {
      position: relative;
      min-height: 440px;
      width: 100%;
      max-width: 520px;
      margin: auto;
    }

    .planet {
      position: absolute;
      border-radius: 50%;
    }

    /* 地球 */
    .planet-earth {
      width: 190px;
      height: 190px;
      left: 31%;
      top: 30%;
      background: #b9ddec;
      box-shadow: inset -13px -11px 0 rgba(99, 150, 190, .08);
      transform: rotate(-13deg);
    }

    .continent {
      position: absolute;
      background: #a9ce97;
      border-radius: 53% 47% 62% 38%;
      opacity: .95;
    }

    .c1 {
      width: 50px;
      height: 31px;
      left: 22px;
      top: 38px;
      transform: rotate(-35deg);
    }

    .c2 {
      width: 44px;
      height: 53px;
      right: 28px;
      top: 28px;
      transform: rotate(24deg);
    }

    .c3 {
      width: 42px;
      height: 26px;
      left: 43px;
      bottom: 28px;
      transform: rotate(23deg);
    }

    .c4 {
      width: 54px;
      height: 30px;
      right: 38px;
      bottom: 33px;
      transform: rotate(-18deg);
    }

    .c5 {
      width: 28px;
      height: 24px;
      left: 88px;
      top: 10px;
      transform: rotate(16deg);
    }

    /* 星球表情 */
    .face {
      position: absolute;
      left: 50%;
      top: 54%;
      transform: translate(-50%, -50%);
      width: 44px;
      height: 25px;
    }

    .eye {
      position: absolute;
      width: 4px;
      height: 7px;
      top: 2px;
      border-radius: 4px;
      background: #525a79;
    }

    .eye.left {
      left: 8px;
    }

    .eye.right {
      right: 8px;
    }

    .smile {
      position: absolute;
      width: 17px;
      height: 8px;
      left: 13px;
      top: 9px;
      border-bottom: 2px solid #525a79;
      border-radius: 0 0 50% 50%;
    }

    .blush {
      position: absolute;
      width: 9px;
      height: 5px;
      top: 12px;
      background: #eeaaa9;
      border-radius: 50%;
      opacity: .8;
    }

    .blush.left {
      left: -2px;
    }

    .blush.right {
      right: -2px;
    }

    /* 土星 */
    .ring-planet {
      width: 142px;
      height: 142px;
      left: 3%;
      top: 5%;
      background: #bddce9;
      box-shadow: inset -10px -9px 0 rgba(94, 140, 185, .08);
    }

    .ring-planet::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 46px;
      left: -22px;
      top: 51px;
      border: 10px solid #91a8df;
      border-top-color: #a8b9e8;
      border-bottom-color: #a8b9e8;
      border-radius: 50%;
      transform: rotate(-19deg);
    }

    /* 月亮 */
    .moon {
      width: 128px;
      height: 151px;
      right: 5%;
      top: 4%;
      background: #f5e39d;
      border-radius: 56% 44% 51% 49% / 40% 46% 54% 60%;
      transform: rotate(17deg);
      box-shadow: inset -8px -9px 0 rgba(199, 164, 82, .06);
    }

    .moon::before,
    .moon::after {
      content: "";
      position: absolute;
      background: #ead78c;
      border-radius: 50%;
      opacity: .75;
    }

    .moon::before {
      width: 19px;
      height: 19px;
      left: 22px;
      top: 41px;
    }

    .moon::after {
      width: 13px;
      height: 13px;
      right: 22px;
      bottom: 35px;
    }

    .moon .face {
      top: 55%;
      left: 49%;
      transform: translate(-50%, -50%) rotate(-17deg) scale(.8);
    }

    /* 飛碟 */
    .ufo {
      position: absolute;
      width: 160px;
      height: 78px;
      right: 0;
      top: 38%;
      transform: rotate(-8deg);
    }

    .ufo .dome {
      position: absolute;
      width: 110px;
      height: 59px;
      left: 25px;
      top: 0;
      background: #9eb6e3;
      border-radius: 65% 65% 42% 42%;
      box-shadow: inset -7px -5px 0 rgba(91, 120, 179, .1);
    }

    .ufo .base {
      position: absolute;
      width: 160px;
      height: 39px;
      left: 0;
      bottom: 4px;
      border-radius: 50%;
      background: #f3df8d;
      border-bottom: 6px solid #e2cf81;
    }

    .ufo .dot {
      position: absolute;
      width: 12px;
      height: 12px;
      top: 15px;
      border-radius: 50%;
      background: #f2aab8;
      z-index: 2;
    }

    .ufo .d1 {
      left: 39px;
    }

    .ufo .d2 {
      left: 73px;
    }

    .ufo .d3 {
      left: 109px;
    }

    .ufo .legs {
      position: absolute;
      width: 18px;
      height: 21px;
      bottom: -9px;
      left: 44px;
      border-left: 5px solid #e4d18b;
      border-radius: 0 0 0 9px;
      transform: rotate(16deg);
    }

    .ufo .legs::after {
      content: "";
      position: absolute;
      height: 21px;
      width: 14px;
      left: 48px;
      top: -3px;
      border-left: 5px solid #e4d18b;
      border-radius: 0 0 0 9px;
    }

    .ufo .face {
      top: 25px;
      z-index: 3;
      transform: translate(-50%, -50%) scale(.65);
    }

    /* 火箭 */
    .rocket {
      position: absolute;
      width: 82px;
      height: 176px;
      left: 4%;
      bottom: 3%;
      transform: rotate(29deg);
    }

    .rocket-body {
      position: absolute;
      inset: 0 13px 28px;
      background: #fae8a9;
      border: 3px solid rgba(223, 194, 126, .42);
      border-radius: 50% 50% 26% 26%;
    }

    .rocket-body::before {
      content: "";
      position: absolute;
      top: 48px;
      left: 13px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: #9fc8e8;
      border: 6px solid #879fd3;
      box-shadow: inset 4px 4px 0 rgba(255,255,255,.45);
    }

    .rocket-tip {
      position: absolute;
      top: -6px;
      left: 18px;
      width: 38px;
      height: 37px;
      background: #43445c;
      border-radius: 80% 5% 0 0;
      transform: rotate(7deg);
    }

    .fin {
      position: absolute;
      bottom: 27px;
      width: 23px;
      height: 40px;
      background: #f3bd9f;
      border-radius: 5px 5px 15px 15px;
    }

    .fin.left {
      left: 0;
      transform: rotate(-17deg);
    }

    .fin.right {
      right: 0;
      transform: rotate(17deg);
    }

    .flame {
      position: absolute;
      bottom: 0;
      left: 25px;
      width: 27px;
      height: 44px;
      background: #f5bd9c;
      border-radius: 20% 20% 55% 55%;
      clip-path: polygon(15% 0, 85% 0, 100% 62%, 50% 100%, 0 62%);
    }

    /* 太空人 */
    .astronaut {
      position: absolute;
      right: 7%;
      bottom: 0;
      width: 145px;
      height: 205px;
      transform: rotate(5deg);
    }

    .astronaut-body {
      position: absolute;
      bottom: 15px;
      left: 19px;
      width: 108px;
      height: 133px;
      background: #fffdf8;
      border: 5px solid #eee9e4;
      border-radius: 44% 44% 34% 34%;
      box-shadow: inset -8px -5px 0 rgba(180, 177, 190, .07);
    }

    .astronaut-helmet {
      position: absolute;
      z-index: 2;
      top: 0;
      left: 7px;
      width: 130px;
      height: 119px;
      background: #fffdf8;
      border: 5px solid #eee9e4;
      border-radius: 48% 48% 44% 44%;
      display: grid;
      place-items: center;
    }

    .visor {
      width: 94px;
      height: 90px;
      border-radius: 48%;
      background: #565278;
      border: 3px solid #e5e0e3;
      position: relative;
    }

    .visor::before {
      content: "";
      position: absolute;
      top: 12px;
      right: 21px;
      width: 8px;
      height: 18px;
      border-radius: 9px;
      background: white;
      transform: rotate(-15deg);
    }

    .astro-arm {
      position: absolute;
      width: 30px;
      height: 82px;
      top: 92px;
      background: #fffdf8;
      border: 4px solid #eee9e4;
      border-radius: 22px;
      z-index: -1;
    }

    .astro-arm.left {
      left: -4px;
      transform: rotate(-48deg);
    }

    .astro-arm.right {
      right: -4px;
      transform: rotate(48deg);
    }

    .control {
      position: absolute;
      z-index: 2;
      left: 44px;
      top: 133px;
      width: 54px;
      height: 29px;
      border-radius: 7px;
      background: #75709e;
      display: flex;
      align-items: center;
      justify-content: space-evenly;
    }

    .control i {
      display: block;
      width: 7px;
      height: 7px;
      border-radius: 2px;
      background: #fffdf9;
    }

    /* 星星與隕石 */
    .star {
      position: absolute;
      color: #efc8ae;
      font-size: 25px;
      line-height: 1;
      opacity: .95;
    }

    .s1 {
      left: 49%;
      top: 7%;
      font-size: 31px;
    }

    .s2 {
      right: 8%;
      top: 28%;
      font-size: 20px;
    }

    .s3 {
      left: 27%;
      top: 51%;
      font-size: 18px;
    }

    .s4 {
      right: 34%;
      bottom: 8%;
      font-size: 28px;
    }

    .s5 {
      left: 2%;
      top: 47%;
      font-size: 20px;
    }

    .asteroid {
      position: absolute;
      width: 70px;
      height: 58px;
      background: #f2b58f;
      border-radius: 43% 57% 53% 47% / 55% 40% 60% 45%;
    }

    .asteroid::before,
    .asteroid::after {
      content: "";
      position: absolute;
      background: #dc9b75;
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .asteroid::before {
      left: 18px;
      top: 14px;
    }

    .asteroid::after {
      right: 16px;
      bottom: 12px;
      width: 7px;
      height: 7px;
    }

    .a1 {
      left: 37%;
      bottom: 3%;
      transform: rotate(20deg) scale(.8);
    }

    .a2 {
      right: 4%;
      bottom: 42%;
      transform: rotate(-15deg) scale(.5);
    }

    /* 關卡選單 */
    .section {
      width: min(1120px, calc(100% - 40px));
      margin: 0 auto 74px;
      scroll-margin-top: 20px;
    }

    .section-head {
      text-align: center;
      margin-bottom: 28px;
    }

    .section-kicker {
      font-size: 11px;
      color: #a1a3bd;
      font-weight: 900;
      letter-spacing: .2em;
    }

    h2 {
      margin: 9px 0 8px;
      font-size: clamp(27px, 3vw, 38px);
      letter-spacing: -.03em;
    }

    .section-desc {
      color: var(--muted);
      margin: 0;
      font-size: 14px;
      line-height: 1.8;
    }

    .levels {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .level-card {
      position: relative;
      min-height: 250px;
      background: rgba(255,255,255,.85);
      border: 1px solid white;
      border-radius: 25px;
      padding: 22px 19px 20px;
      box-shadow: 0 10px 30px rgba(111,120,173,.08);
      overflow: hidden;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .level-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 17px 35px rgba(111,120,173,.14);
    }

    .level-card::after {
      content: "";
      position: absolute;
      width: 100px;
      height: 100px;
      right: -36px;
      top: -37px;
      border-radius: 50%;
      opacity: .55;
    }

    .level-card:nth-child(1)::after {
      background: #cbe6f0;
    }

    .level-card:nth-child(2)::after {
      background: #f8e8a9;
    }

    .level-card:nth-child(3)::after {
      background: #f6d2dc;
    }

    .level-card:nth-child(4)::after {
      background: #cecaef;
    }

    .level-number {
      position: relative;
      z-index: 1;
      width: 47px;
      height: 47px;
      display: grid;
      place-items: center;
      border-radius: 16px;
      color: #5f719b;
      font-size: 18px;
      font-weight: 950;
      background: #e5f2f7;
      margin-bottom: 17px;
    }

    .level-card:nth-child(2) .level-number {
      background: #fcf1c9;
      color: #9c8545;
    }

    .level-card:nth-child(3) .level-number {
      background: #fde7ec;
      color: #b77991;
    }

    .level-card:nth-child(4) .level-number {
      background: #ece9fb;
      color: #7872ac;
    }

    .level-card h3 {
      margin: 0 0 9px;
      font-size: 17px;
    }

    .level-card p {
      margin: 0;
      color: #8388a4;
      line-height: 1.75;
      font-size: 12px;
      min-height: 43px;
    }

    .level-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 17px;
      text-decoration: none;
      font-weight: 900;
      font-size: 12px;
      color: #7898cf;
    }

    .level-link span {
      transition: transform .2s ease;
    }

    .level-link:hover span {
      transform: translateX(4px);
    }

    /* 頁尾 */
    .footer {
      text-align: center;
      padding: 4px 20px 28px;
      color: #a0a3bb;
      font-size: 11px;
      letter-spacing: .08em;
    }

    .footer .planet-dot {
      display: inline-block;
      width: 7px;
      height: 7px;
      background: #bcdceb;
      border-radius: 50%;
      margin: 0 7px 1px;
    }

    /* 平板與手機版 */
    @media (max-width: 900px) {
      .hero {
        grid-template-columns: 1fr;
        padding-bottom: 25px;
      }

      .hero-copy {
        text-align: center;
      }

      .subtitle {
        margin-left: auto;
        margin-right: auto;
      }

      .hero-actions {
        justify-content: center;
      }

      .art {
        min-height: 410px;
        width: min(100%, 480px);
      }

      .levels {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 520px) {
      .topbar {
        width: calc(100% - 28px);
        min-height: 65px;
      }

      .top-note {
        display: none;
      }

      .hero,
      .section {
        width: calc(100% - 24px);
      }

      .hero {
        border-radius: 27px;
        padding: 29px 20px 15px;
        margin-bottom: 45px;
      }

      h1 {
        font-size: clamp(38px, 12vw, 52px);
      }

      .subtitle {
        font-size: 13px;
      }

      .art {
        min-height: 320px;
        transform: scale(.84);
        transform-origin: top center;
        margin-bottom: -45px;
      }

      .planet-earth {
        width: 145px;
        height: 145px;
        left: 30%;
        top: 32%;
      }

      .ring-planet {
        width: 105px;
        height: 105px;
        left: 2%;
        top: 6%;
      }

      .ring-planet::after {
        width: 135px;
        height: 36px;
        left: -18px;
        top: 35px;
        border-width: 8px;
      }

      .moon {
        transform: scale(.82) rotate(17deg);
        transform-origin: top right;
        right: -2%;
        top: 4%;
      }

      .ufo {
        transform: scale(.8) rotate(-8deg);
        transform-origin: top right;
        right: -2%;
        top: 38%;
      }

      .rocket {
        transform: scale(.78) rotate(29deg);
        transform-origin: bottom left;
        left: 1%;
        bottom: 0;
      }

      .astronaut {
        transform: scale(.8) rotate(5deg);
        transform-origin: bottom right;
        right: 0;
        bottom: 0;
      }

      .levels {
        gap: 11px;
      }

      .level-card {
        padding: 18px 15px;
        min-height: 245px;
        border-radius: 20px;
      }

      .level-card h3 {
        font-size: 15px;
      }

      .level-card p {
        font-size: 11px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
